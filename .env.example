# Supabase: your own development project, never a production secret
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Only needed for server-side privileged Supabase operations
SUPABASE_SERVICE_ROLE_KEY=
# Use only the test widget key pair from the same Toss merchant
VITE_TOSS_CLIENT_KEY=test_gck_your_widget_client_key
TOSS_SECRET_KEY=test_gsk_your_widget_secret_key
